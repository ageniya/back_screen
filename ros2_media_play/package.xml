<?xml version="1.0"?>
<package format="3">
  <name>zj_media_play</name>
  <version>0.1.0</version>
  <description>ROS2 on-demand face video player for the Pico rear display.</description>
  <maintainer email="robot@example.invalid">Robot Team</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>navi_robot_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
