# Keep empty to run the built-in mock diagnostic engine.
# When the existing diagnosis engine is available, set its full WebSocket URL.
DIAGNOSIS_WS_URL=

# 默认 mock：不读取或控制真实机器人。部署在机器人 ROS 2 环境后才设为 ros。
TELEMETRY_MODE=mock
# ROS2 实机/仿真模式：先 source 对应 ROS 环境，再设置 TELEMETRY_MODE=ros。
# ROS_JOINT_STATES_TOPIC=/fake/upperlimb/joint_states
# ROS_LEFT_TCP_TOPIC=/fake/upperlimb/tcp_pose/left_arm
# ROS_RIGHT_TCP_TOPIC=/fake/upperlimb/tcp_pose/right_arm
# 优先使用机器人实际环境中的 ROBOT_NAME，例如 zj_humanoid_5001。
# 若未设置，则回退为 zj_humanoid；ROS_NAMESPACE 可显式覆盖它。
ROBOT_NAME=
ROS_NAMESPACE=
# ROS 急停调用默认关闭。必须完成安全评审后才允许设为 true。
ROS_ENABLE_CONTROL=false
# 相机实例名因机型而异；确认实机话题后再填写，空值将显示“未知”。
ROS_DEPTH_CAMERA_TOPIC=
ROS_CAMERA_TOPIC=
# Pico 使用 /robot/stop；WA 底盘软急停可填写 /chassis/soft_estop。
ROS_STOP_SERVICE=

# Comma-separated browser origins allowed to call this service.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174
