# 留空时使用内置实时诊断。
# When the existing diagnosis engine is available, set its full WebSocket URL.
DIAGNOSIS_WS_URL=

# 真实 ROS2 数据模式。
TELEMETRY_MODE=ros
# 已知设备型号。实机 basic_info 服务返回非空型号时会自动覆盖它；
# 这样该服务未启动时背屏也不会显示 unknown。
ROBOT_MODEL=
# Pico 的 ROS resource 话题没有发布时，读取 Pico 本机 Linux 资源；仅在 Pico 设置。
# LOCAL_RESOURCE_SOURCE=pico
# 告警持续多久才展示；短暂恢复的瞬时波动不会进入告警页。
ALARM_PERSIST_SECONDS=5
# ROS2 实机模式：先 source 对应 ROS 环境，再设置 TELEMETRY_MODE=ros。
# Pico 实机已验证的上肢状态接口：双臂、颈部和升降轴共用 JointState；
# 左右 TCP 使用 upperlimb_msgs/msg/Pose。/fake/... 仅供示教/仿真，禁止作为实机数据源。
# ROS_JOINT_STATES_TOPIC=/zj_humanoid/upperlimb/joint_states
# ROS_LEFT_TCP_TOPIC=/zj_humanoid/upperlimb/tcp_pose/left_arm
# ROS_RIGHT_TCP_TOPIC=/zj_humanoid/upperlimb/tcp_pose/right_arm
# ROS_UPPERLIMB_STATE_TOPIC=/zj_humanoid/upperlimb/uplimb_state
# 最新底盘接口文档中的 2D 雷达输出；不要默认使用旧版 /scan。
# ROS_LIDAR_1_TOPIC=/zj_humanoid/chassis/laser_scan
# ROS_LIDAR_2_TOPIC=
# ROS_LEFT_WRIST_CAMERA_TOPIC=/zj_humanoid/sensor/left_wrist/color/image_raw
# ROS_RIGHT_WRIST_CAMERA_TOPIC=/zj_humanoid/sensor/right_wrist/color/image_raw
# 优先使用机器人实际环境中的 ROBOT_NAME，例如 zj_humanoid_5001。
# 若未设置，则回退为 zj_humanoid；ROS_NAMESPACE 可显式覆盖它。
ROBOT_NAME=
ROS_NAMESPACE=
# 实机底盘控制默认关闭。软件急停不替代实体急停；确认安全策略后才允许启用。
ROS_ENABLE_CONTROL=false
# 只开放人工复位，不会开放软件急停 API 或自动启动运动。
ROS_ENABLE_RESET=false
# 相机实例名因机型而异；确认实机话题后再填写，空值将显示“未知”。
ROS_DEPTH_CAMERA_TOPIC=
ROS_CAMERA_TOPIC=
# 兼容 Orin 的 Web 桥接数据，例如：
# ROS_BATTERY_TOPICS=/web/battery_info
# 第二块电池独立订阅，默认包含 /robot/battery2_info；不要填进第一块的话题列表。
# ROS_BATTERY2_TOPICS=/web/battery2_info
# ROS_ODOM_TOPICS=/web/odom_info
# 默认使用 /zj_humanoid/chassis/soft_estop；具体服务名以现场为准。
ROS_STOP_SERVICE=
# 后端从 AGVNewState 派生急停/复位状态，不再需要外部 controlState 话题。
ROS_RESET_TIMEOUT_SECONDS=10
# 我们自己的 robot-motion-supervisor 在底盘主机运行，提供
# /{ROBOT_NAME}/back_screen/reset 和 reset_status，并管理运动门控。
# 先完成三路底盘入口重映射，不能仅开启以上开关绕过门控。

# 默认读取 /diagnostics、/{ROBOT_NAME}/robot/diagnostics、
# /{ROBOT_NAME}/robot/diagnostics/robot_state_node 和 Orin/Pico 资源诊断。
# 仅在现场确认其它汇总有效时覆盖；旧 /diagnostics_agg 可能包含未接入的过期分组。
# ROS_DIAGNOSTICS_TOPICS=/diagnostics,/zj_humanoid/robot/diagnostics,/zj_humanoid/robot/diagnostics/robot_state_node,/zj_humanoid/robot/orin_states/diagnostics_agg

# Comma-separated browser origins allowed to call this service.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174

# 本机身份与另一台计算单元地址（填写实际地址）
# BACK_SCREEN_DEVICE_ROLE=pico
# ORIN_IP=192.168.217.100
