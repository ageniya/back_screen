[Unit]
Description=Robot back-screen Pico API and web page
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nav01
WorkingDirectory=/opt/robot-back-screen
EnvironmentFile=/etc/robot-back-screen/env
ExecStart=/bin/bash /opt/robot-back-screen/deploy/start-pico-api.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
