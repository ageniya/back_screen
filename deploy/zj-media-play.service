[Unit]
Description=ZJ ROS2 on-demand face media player
After=network.target

[Service]
Type=simple
User=nav01
Environment=DISPLAY=:1
Environment=XAUTHORITY=/run/user/1000/gdm/Xauthority
ExecStart=/bin/bash -lc 'source /etc/nav01/Middleware.env && source /opt/ros/humble/setup.bash && source /home/nav01/ros2_media_play_ws/install/setup.bash && ros2 launch zj_media_play media_play.launch.py display:=:1 xauthority:=/run/user/1000/gdm/Xauthority media_dir:=/opt/zj_humanoid/media_play'
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
